# Firebase configuration is intentionally kept outside source control.
# Copy these keys to .env.local and use the values from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=smart-farmer-procurement
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# In Firebase Console, enable Authentication > Sign-in method > Email/Password.
# Create officer Auth users, then add /users/{uid} with role "officer" in the
# Firebase console. The assisted portal also uses service_centers for its center
# assignment metadata.
